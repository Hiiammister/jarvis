# Copy this to .env and fill in your values

# Ollama model to use (default: qwen3:8b)
# Other options you have installed: llama2, north-mini-code-1.0
# OLLAMA_MODEL=qwen3:8b

# Optional: override the LLM loop settings (defaults shown)
# MAX_TOKENS=2048            # DEEP profile output cap (coding / research / long work)
# BELLA_NORMAL_TOKENS=512    # NORMAL profile cap (ordinary questions)
# BELLA_FAST_TOKENS=96       # FAST profile cap (greetings / quick chat)
# CTX_SIZE=4096              # Ollama num_ctx — NEVER varied per turn (KV-cache realloc)
# MAX_TOOL_ITERATIONS=12     # tool round-trips per turn
# OLLAMA_THINK=0             # 1 keeps the <think> preamble (slower)

# Keep the model resident so an active session doesn't repeatedly pay the
# ~2-4s model-load cost. "30m" default; "-1" = forever; "0" = Ollama's own 5m.
# OLLAMA_KEEP_ALIVE=30m
# BELLA_WARMUP=1             # fire a 1-token generation on startup to pre-load

# State directory (session DB, prompt history). Default: ~/.jarvis
# BELLA_HOME=~/.jarvis

# Verbose CLI output (exact tool names, args, timings, raw tool output).
# Same as `bella --verbose` / the /verbose slash command.
# BELLA_VERBOSE=0

# Tool permission enforcement. Both default to true, matching prior behaviour
# (everything runs). Set to false to make that class of tool call return a
# "requires confirmation" error instead of executing.
# ALLOW_UNCONFIRMED_WRITE=true   # WRITE calls: write_file, git commit/push, package install
# ALLOW_DANGEROUS=true           # DANGEROUS calls: rm -rf, sudo, disk ops, etc.

# Spotify: needed to play/search tracks by name (Client Credentials flow, no user login).
# Create an app at https://developer.spotify.com/dashboard and copy its ID/secret.
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=

# ── Bella hub (server) ────────────────────────────────────────────────────
# `bella serve` is the central brain. Windows / iPad / web connect to it as
# clients over the LAN or Tailscale. It refuses to start without a token —
# it can run shell commands on this Mac AND on connected devices.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# JARVIS_TOKEN=

# 127.0.0.1 = local-only (default, safe). 0.0.0.0 = reachable on LAN/Tailscale.
# SERVER_HOST=0.0.0.0
# SERVER_PORT=8765

# ── Bella client (this machine as a device) ──────────────────────────────
# Used by `bella client` / `python client.py`. The token is the server's
# JARVIS_TOKEN.
# BELLA_SERVER=ws://your-mac.local:8765
# BELLA_TOKEN=
# BELLA_DEVICE_NAME=Gaming PC

# Trial voice feature (tools/voice.py) — spoken replies via ElevenLabs.
# Local-only: only the REPL on this machine speaks; never wired into
# server.py, so remote devices never trigger or receive audio.
# Get a key at https://elevenlabs.io/app/settings/api-keys
# JARVIS_VOICE=1
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL=eleven_turbo_v2_5

# Trial voice INPUT feature (tools/ears.py) — mic -> ElevenLabs Speech-to-
# Text, via the REPL's /listen command. Uses the same ELEVENLABS_API_KEY
# above; no separate key needed.
# ELEVENLABS_STT_MODEL=scribe_v1
#
# Run `python tools/ears.py --calibrate` once and it'll suggest a value for
# this based on your actual room/mic — the default is an unmeasured guess.
# ELEVENLABS_STT_RMS_THRESHOLD=2500
